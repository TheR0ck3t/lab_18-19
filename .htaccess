RewriteEngine On

# Jeżeli plik lub folder istnieje w public/, serwuj go
RewriteCond %{DOCUMENT_ROOT}/lab_18-19/public/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/lab_18-19/public/$1 -d
RewriteRule ^(.*)$ /lab_18-19/public/$1 [L]

# Jeżeli istnieje .html plik w public/ bez rozszerzenia – przekieruj
RewriteCond %{DOCUMENT_ROOT}/lab_18-19/public/$1.html -f
RewriteRule ^(.*)$ /lab_18-19/public/$1.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Redirect to clean URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# Blokuj listingi
Options -Indexes
